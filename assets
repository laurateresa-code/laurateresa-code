<svg
  width="900"
  height="260"
  viewBox="0 0 900 260"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="title desc"
>
  <title id="title">Seja bem-vindo ao GitHub de Laura Teresa</title>
  <desc id="desc">
    Tela retro em rosa com a mensagem Seja bem-vindo e o usuário GitHub @laurateresa-code.
  </desc>

  <defs>
    <!-- Fundo -->
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0b070d"/>
      <stop offset="50%" stop-color="#190b18"/>
      <stop offset="100%" stop-color="#080509"/>
    </linearGradient>

    <!-- Brilho rosa -->
    <filter id="pinkGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Brilho mais suave -->
    <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2"/>
    </filter>

    <!-- Scanlines -->
    <pattern
      id="scanlines"
      width="4"
      height="8"
      patternUnits="userSpaceOnUse"
    >
      <rect
        width="4"
        height="1"
        fill="#ff69b4"
        opacity="0.06"
      />
    </pattern>

    <!-- Máscara da tela -->
    <clipPath id="screenClip">
      <rect
        x="25"
        y="25"
        width="850"
        height="210"
        rx="12"
      />
    </clipPath>
  </defs>

  <!-- ================================= -->
  <!-- FUNDO -->
  <!-- ================================= -->

  <rect
    width="900"
    height="260"
    rx="16"
    fill="url(#background)"
  />

  <!-- Brilho ambiente -->
  <ellipse
    cx="450"
    cy="125"
    rx="330"
    ry="95"
    fill="#ff69b4"
    opacity="0.035"
    filter="url(#softGlow)"
  />

  <!-- ================================= -->
  <!-- JANELA -->
  <!-- ================================= -->

  <rect
    x="25"
    y="25"
    width="850"
    height="210"
    rx="12"
    fill="none"
    stroke="#ff69b4"
    stroke-width="2"
    opacity="0.75"
  />

  <!-- Barra superior -->
  <path
    d="M37 25
       H863
       Q875 25 875 37
       V59
       H25
       V37
       Q25 25 37 25Z"
    fill="#ff69b4"
    opacity="0.07"
  />

  <!-- ================================= -->
  <!-- BOTÕES DA JANELA -->
  <!-- ================================= -->

  <circle
    cx="48"
    cy="42"
    r="5"
    fill="#ff69b4"
    opacity="0.9"
  />

  <circle
    cx="67"
    cy="42"
    r="5"
    fill="#ffb6d9"
    opacity="0.7"
  />

  <circle
    cx="86"
    cy="42"
    r="5"
    fill="#ffffff"
    opacity="0.35"
  />

  <!-- Prompt -->
  <text
    x="115"
    y="47"
    fill="#ff9dcc"
    font-family="monospace"
    font-size="13"
    opacity="0.65"
  >
    laura@github:~$
  </text>

  <!-- ================================= -->
  <!-- CONTEÚDO -->
  <!-- ================================= -->

  <g clip-path="url(#screenClip)">

    <!-- Pequeno brilho atrás do título -->
    <text
      x="450"
      y="125"
      text-anchor="middle"
      fill="#ff69b4"
      font-family="'Courier New', monospace"
      font-size="38"
      font-weight="bold"
      letter-spacing="4"
      opacity="0.15"
      filter="url(#softGlow)"
    >
      SEJA BEM-VINDO
    </text>

    <!-- ================================= -->
    <!-- TÍTULO -->
    <!-- ================================= -->

    <text
      x="450"
      y="125"
      text-anchor="middle"
      fill="#ff69b4"
      font-family="'Courier New', monospace"
      font-size="38"
      font-weight="bold"
      letter-spacing="4"
      filter="url(#pinkGlow)"
    >
      SEJA BEM-VINDO

      <!-- Aparece suavemente -->
      <animate
        attributeName="opacity"
        values="0;0;1;1"
        keyTimes="0;0.15;0.45;1"
        dur="2s"
        repeatCount="indefinite"
      />
    </text>

    <!-- ================================= -->
    <!-- CURSOR -->
    <!-- ================================= -->

    <rect
      x="750"
      y="94"
      width="11"
      height="38"
      rx="1"
      fill="#ff69b4"
      filter="url(#pinkGlow)"
    >
      <animate
        attributeName="opacity"
        values="1;0;1;0;1"
        dur="1s"
        repeatCount="indefinite"
      />
    </rect>

    <!-- ================================= -->
    <!-- ÍCONE DO GITHUB -->
    <!-- ================================= -->

    <g
      transform="translate(345 151) scale(0.65)"
      fill="#ffc1df"
      opacity="0"
    >

      <path
        d="M48 0C21.5 0 0 21.5 0 48c0 21.2 13.8 39.2 32.9 45.6
        2.4.4 3.3-1 3.3-2.3v-8.1c-13.4 2.9-16.2-6.5-16.2-6.5
        -2.2-5.6-5.3-7.1-5.3-7.1-4.4-3 .3-3 .3-3
        4.9.3 7.5 5 7.5 5 4.4 7.5 11.5 5.3 14.3 4
        .4-3.1 1.7-5.3 3.1-6.5-10.7-1.2-21.9-5.4-21.9-23.8
        0-5.3 1.9-9.6 5-13-0.5-1.2-2.2-6.2.5-12.9
        0 0 4.1-1.3 13.4 5 3.9-1.1 8-1.7 12.1-1.7
        4.1 0 8.2.6 12.1 1.7 9.3-6.3 13.4-5 13.4-5
        2.7 6.7 1 11.7.5 12.9 3.1 3.4 5 7.7 5 13
        0 18.4-11.2 22.6-21.9 23.8 1.7 1.5 3.3 4.4 3.3 8.9
        v13.2c0 1.3.9 2.8 3.3 2.3C82.2 87.2 96 69.2 96 48
        96 21.5 74.5 0 48 0Z"
      />

      <!-- Entrada suave -->
      <animate
        attributeName="opacity"
        values="0;0;1;1"
        keyTimes="0;0.45;0.55;1"
        dur="3s"
        repeatCount="indefinite"
      />

      <!-- Pequeno deslocamento -->
      <animateTransform
        attributeName="transform"
        type="translate"
        values="345 154;345 151;345 151"
        keyTimes="0;0.55;1"
        dur="3s"
        repeatCount="indefinite"
      />

    </g>

    <!-- ================================= -->
    <!-- USUÁRIO -->
    <!-- ================================= -->

    <text
      x="490"
      y="180"
      text-anchor="middle"
      fill="#ffc1df"
      font-family="monospace"
      font-size="18"
      letter-spacing="2"
      opacity="0"
    >
      @laurateresa-code

      <animate
        attributeName="opacity"
        values="0;0;1;1"
        keyTimes="0;0.45;0.6;1"
        dur="3s"
        repeatCount="indefinite"
      />
    </text>

    <!-- ================================= -->
    <!-- SCANLINES -->
    <!-- ================================= -->

    <rect
      x="25"
      y="25"
      width="850"
      height="210"
      fill="url(#scanlines)"
      pointer-events="none"
    />

    <!-- ================================= -->
    <!-- LINHA DE VARREDURA -->
    <!-- ================================= -->

    <rect
      x="25"
      y="60"
      width="850"
      height="2"
      fill="#ff69b4"
      opacity="0.08"
    >
      <animate
        attributeName="y"
        values="60;225;60"
        dur="5s"
        repeatCount="indefinite"
      />
    </rect>

  </g>

  <!-- ================================= -->
  <!-- RODAPÉ -->
  <!-- ================================= -->

  <text
    x="450"
    y="215"
    text-anchor="middle"
    fill="#ff69b4"
    font-family="monospace"
    font-size="11"
    letter-spacing="2"
    opacity="0.5"
  >
    SYSTEM READY • DEVELOPER MODE
  </text>

</svg>
